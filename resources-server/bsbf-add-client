if [ $# -lt 1 ] || [ $# -gt 3 ]; then
	echo "Usage: $0 <MBPS> [PORT] [--overwrite]"
	exit 1
fi

SPEED="$1"
PORT=""
OVERWRITE=""
shift

while [ $# -gt 0 ]; do
	case "$1" in
	--overwrite)
		[ -z "$OVERWRITE" ] || {
			echo "ERROR: --overwrite specified more than once" >&2
			exit 1
		}
		OVERWRITE="--overwrite"
		;;
	*[!0-9]*)
		echo "ERROR: Invalid port: $1 (must be 1-49151)" >&2
		exit 1
		;;
	*)
		[ -z "$PORT" ] || {
			echo "ERROR: Only one custom port may be specified" >&2
			exit 1
		}
		PORT="$1"
		;;
	esac
	shift
done

case "$SPEED" in
	*[!0-9]*|"")
		echo "ERROR: Invalid speed" >&2
		exit 1
		;;
esac

if [ -n "$PORT" ]; then
	[ "$PORT" -ge 1 ] && [ "$PORT" -le 49151 ] || {
		echo "ERROR: Invalid port: $PORT (must be 1-49151)" >&2
		exit 1
	}
fi

BASE_CLIENT_ID=16384
CLIENT_LIMIT=16384

# Generate a UUID.
UUID=$(xray uuid)

# Create xray configuration for client on server.
CLIENT_ID=$BASE_CLIENT_ID
if [ -n "$PORT" ]; then
	CLIENT_ID="$PORT"
	if find /usr/local/etc/xray-bsbf-bonding -maxdepth 1 -type f -name "$CLIENT_ID-*.json" -print -quit | grep -q .; then
		echo "ERROR: Port $PORT is already in use" >&2
		exit 1
	fi
else
	while find /usr/local/etc/xray-bsbf-bonding -maxdepth 1 -type f -name "$CLIENT_ID-*.json" -print -quit | grep -q .; do
		CLIENT_ID=$((CLIENT_ID + 1))
	done
fi

# When client limit is reached, exit if overwrite argument is not given. Use
# greater than or equals to ensure the client limit excess is detected. Then,
# empty the next slot and use that for the client.
if [ $CLIENT_ID -ge $((BASE_CLIENT_ID + CLIENT_LIMIT)) ]; then
	[ -z "$OVERWRITE" ] && exit 1
	bsbf-remove-client $BASE_CLIENT_ID
	CLIENT_ID=$BASE_CLIENT_ID
fi
# Empty the next slot if overwrite argument is given.
[ -n "$OVERWRITE" ] && [ -z "$PORT" ] && bsbf-remove-client $((CLIENT_ID + 1))

# Add client to server.
PORT=${PORT:-$CLIENT_ID}
INBOUND_MARK=$CLIENT_ID
OUTBOUND_MARK=$((CLIENT_ID + 16384))

cat > "/usr/local/etc/xray-bsbf-bonding/$PORT-$UUID-$SPEED.json" <<EOF
{
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": $PORT,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$UUID"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "sockopt": {
          "mark": $INBOUND_MARK,
          "tcpMptcp": true
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "mark": $OUTBOUND_MARK
        }
      }
    }
  ]
}
EOF

# Start and enable xray for client.
systemctl start xray-bsbf-bonding@$PORT-$UUID-$SPEED
systemctl enable --quiet xray-bsbf-bonding@$PORT-$UUID-$SPEED

# Return port and UUID.
echo "$PORT" "$UUID"

# Do rate limiting.
# Use the interface from the preferred default route. If there's no interface,
# rate limiting will be added by the 99-bsbf-rate-limiting if-up.d script when
# an interface comes up, therefore, exit.
IFACE=$(ip route show default | awk 'NR==1 {for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}')
[ -n "$IFACE" ] || exit

# Skip rate limiting if given speed is 0.
[ "$SPEED" -eq 0 ] && exit

# Convert to hex for tc.
INBOUND_MARK_HEX=$(printf '%x' $INBOUND_MARK)
OUTBOUND_MARK_HEX=$(printf '%x' $OUTBOUND_MARK)

# Add two classes for HTB, to rate limit download and upload to given limit.
tc class add dev "$IFACE" parent 1:0 classid 1:$INBOUND_MARK_HEX htb rate "$SPEED"mbit 2>/dev/null
tc class add dev "$IFACE" parent 1:0 classid 1:$OUTBOUND_MARK_HEX htb rate "$SPEED"mbit 2>/dev/null
# Limit download rate of client.
tc filter add dev "$IFACE" parent 1:0 handle 0x$INBOUND_MARK_HEX fw classid 1:$INBOUND_MARK_HEX
# Limit upload rate of client.
tc filter add dev "$IFACE" parent 1:0 handle 0x$OUTBOUND_MARK_HEX fw classid 1:$OUTBOUND_MARK_HEX
