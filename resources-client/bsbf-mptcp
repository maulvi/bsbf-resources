BSBF_CONFIG_DIR=/usr/local/etc/bsbf
[ ! -d "$BSBF_CONFIG_DIR" ] && BSBF_CONFIG_DIR=/etc/bsbf
BSBF_MPTCP_BACKUP="$BSBF_CONFIG_DIR/bsbf-mptcp-subflow-backup"
INTERVAL=1
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=5
CURL_ARGS="-s -4 --max-time 5 --retry 2 --retry-all-errors --resolve check.mptcp.dev:80:5.196.67.207 check.mptcp.dev"
STATE_DIR=/run/bsbf-mptcp-health

mkdir -p "$STATE_DIR"
touch \
	/run/bsbf-mptcp-no-connectivity \
	/run/bsbf-mptcp-not-supported \
	/run/bsbf-mptcp-supported

# Set subflow limit to 8.
ip mp limits set subflows 8

# Disable blackhole timeout.
sysctl net.mptcp.blackhole_timeout=0 >/dev/null

# Disable fallback to TCP.
sysctl net.mptcp.syn_retrans_before_tcp_fallback=128 >/dev/null

health_file() {
	echo "$STATE_DIR/$1"
}

get_count() {
	file=$(health_file "$1")
	[ -s "$file" ] && cat "$file" || echo 0
}

set_count() {
	echo "$2" > "$(health_file "$1")"
}

mark_unhealthy() {
	IFACE="$1"

	grep -xq "$IFACE" /run/bsbf-mptcp-no-connectivity && return 0
	echo "$IFACE" >> /run/bsbf-mptcp-no-connectivity

	# Remove the MPTCP endpoint immediately after sustained failures.
	# This leaves the kernel free to use the remaining healthy path(s).
	if grep -xq "$IFACE" /run/bsbf-mptcp-supported; then
		bsbf-mptcp-helper remove "$IFACE"
	fi

	set_count "$IFACE.fail" 0
	set_count "$IFACE.ok" 0
	logger -t bsbf-mptcp "Interface $IFACE marked unhealthy; MPTCP endpoint removed."
}

mark_healthy() {
	IFACE="$1"

	if grep -xq "$IFACE" /run/bsbf-mptcp-no-connectivity; then
		sed "/^$IFACE$/d" /run/bsbf-mptcp-no-connectivity > /run/bsbf-mptcp-no-connectivity.tmp
		mv /run/bsbf-mptcp-no-connectivity.tmp /run/bsbf-mptcp-no-connectivity
	fi

	# Re-add the endpoint only after recovery has been stable.
	if grep -xq "$IFACE" /run/bsbf-mptcp-supported; then
		if ! ip mp e | awk -v dev="$IFACE" '$0 ~ "dev " dev "([[:space:]]|$)" {found=1} END {exit !found}'; then
			bsbf-mptcp-helper add "$IFACE"
		fi
	fi

	set_count "$IFACE.fail" 0
	set_count "$IFACE.ok" 0
	logger -t bsbf-mptcp "Interface $IFACE recovered; MPTCP endpoint restored."
}

while true; do
	sleep "$INTERVAL"

	# Get all default routes with a metric. Route metrics are intentionally
	# left untouched: OpenWrt keeps WAN preference/fallback stable while MPTCP
	# health is handled independently through endpoint state.
	routes=$(ip route show | grep "^default" | grep "metric")

	# Flush the MPTCP endpoint table and continue if there are no routes.
	[ -z "$routes" ] && { ip mp e f ; continue; }

	# Remove stale health state for interfaces that are no longer routed.
	interfaces=$(echo "$routes" | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')
	echo "$interfaces" | grep -xf - /run/bsbf-mptcp-no-connectivity > /run/bsbf-mptcp-no-connectivity.tmp
	echo "$interfaces" | grep -xf - /run/bsbf-mptcp-not-supported > /run/bsbf-mptcp-not-supported.tmp
	echo "$interfaces" | grep -xf - /run/bsbf-mptcp-supported > /run/bsbf-mptcp-supported.tmp
	mv /run/bsbf-mptcp-no-connectivity.tmp /run/bsbf-mptcp-no-connectivity
	mv /run/bsbf-mptcp-not-supported.tmp /run/bsbf-mptcp-not-supported
	mv /run/bsbf-mptcp-supported.tmp /run/bsbf-mptcp-supported

	for IFACE in $interfaces; do
		# Check path reachability. A single failed probe is not enough to
		# declare the WAN dead; hysteresis prevents flapping on transient loss.
		if fping -q 5.196.67.207 -b 0 -t 1000 -I "$IFACE" >/dev/null 2>&1; then
			set_count "$IFACE.fail" 0
			OK_COUNT=$(get_count "$IFACE.ok")
			OK_COUNT=$((OK_COUNT + 1))
			set_count "$IFACE.ok" "$OK_COUNT"

			# A currently healthy endpoint needs no further action.
			if ! grep -xq "$IFACE" /run/bsbf-mptcp-no-connectivity; then
				set_count "$IFACE.ok" 0
			else
				[ "$OK_COUNT" -ge "$RECOVER_THRESHOLD" ] && mark_healthy "$IFACE"
			fi
		else
			set_count "$IFACE.ok" 0
			FAIL_COUNT=$(get_count "$IFACE.fail")
			FAIL_COUNT=$((FAIL_COUNT + 1))
			set_count "$IFACE.fail" "$FAIL_COUNT"

			# Require sustained failures before removing the path.
			[ "$FAIL_COUNT" -ge "$FAIL_THRESHOLD" ] && mark_unhealthy "$IFACE"
			continue
		fi

		# Continue if the interface is in the not-supported list.
		grep -xq "$IFACE" /run/bsbf-mptcp-not-supported && continue

		# Check MPTCP support on the interface if it's not in the
		# supported list.
		if ! grep -xq "$IFACE" /run/bsbf-mptcp-supported; then
			OUTPUT=$(mptcpize run curl $CURL_ARGS --interface "$IFACE")
			if [ "$OUTPUT" = "You are using MPTCP." ]; then
				echo "$IFACE" >> /run/bsbf-mptcp-supported
				bsbf-mptcp-helper add "$IFACE"
			else
				echo "$IFACE" >> /run/bsbf-mptcp-not-supported
			fi
		fi
	done

	# Make supported interface backups if configured so.
	while read IFACE; do
		[ -z "$IFACE" ] && continue
		if grep -xq "$IFACE" "$BSBF_MPTCP_BACKUP" 2>/dev/null; then
			bsbf-mptcp-helper backup "$IFACE"
		else
			bsbf-mptcp-helper nobackup "$IFACE"
		fi
	done < /run/bsbf-mptcp-supported

done
